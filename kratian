function addWordDirect() {
    const kEl = document.getElementById('inputKratian');
    const eEl = document.getElementById('inputEnglish');
    const cEl = document.getElementById('inputCategory');
    if (!kEl || !eEl || !cEl) return;

    const kratian = kEl.value.trim();
    const english = eEl.value.trim();
    const category = cEl.value;

    if (!kratian || !english) return;

    let customEntries = JSON.parse(localStorage.getItem('kratian_custom_entries') || '[]');
    customEntries.push({ kratian, english, category, notes: 'Manual entry' });
    localStorage.setItem('kratian_custom_entries', JSON.stringify(customEntries));

    // Clear inputs
    kEl.value = '';
    eEl.value = '';

    renderLexicon();
}
