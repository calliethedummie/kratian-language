        function renderLexicon() {
            const tbody = document.getElementById('lexiconBody');
            if (!tbody) return;
            tbody.innerHTML = lexiconData.map(item => `
                <tr>
                    <td class="kratian">${item.kratian}</td>
                    <td>${item.english}</td>
                    <td>${item.category}</td>
                    <td>${item.notes}</td>
